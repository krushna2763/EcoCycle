# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# MongoDB connection string. Use your own Atlas cluster or a local MongoDB, for example:
#   mongodb+srv://<username>:<password>@<cluster-host>/EcoCycle?retryWrites=true&w=majority
#   mongodb://127.0.0.1:27017/EcoCycle
MONGODB_URI=mongodb://127.0.0.1:27017/EcoCycle

# Long random string used to sign login tokens (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Origin of the web client, used for CORS and Socket.IO
CLIENT_URL=http://localhost:5173

# Optional tuning (defaults shown)
# RATE_LIMIT_MAX=300               # API requests per IP per 15 minutes
# UPLOAD_DAILY_LIMIT_MB=50         # image upload allowance per user per 24 hours
# ORPHAN_IMAGE_SWEEP_HOURS=6       # how often unused uploaded images are removed (0 turns it off)
# ORPHAN_IMAGE_MIN_AGE_HOURS=24    # uploads younger than this are never removed (minimum 1)
