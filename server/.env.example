# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# MongoDB connection string. Use your own Atlas cluster or a local MongoDB, for example:
#   mongodb+srv://<username>:<password>@<cluster-host>/EcoCycle?retryWrites=true&w=majority
#   mongodb://127.0.0.1:27017/EcoCycle
MONGODB_URI=mongodb://127.0.0.1:27017/EcoCycle

# Random secret used to sign login tokens: at least 32 random bytes, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The value below is a placeholder; with NODE_ENV=production the server refuses to start until it is replaced.
# Changing the secret signs everyone out (existing tokens stop working).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Origin of the web client, used for CORS and Socket.IO
CLIENT_URL=http://localhost:5173

# Optional settings (defaults shown)
# NODE_ENV=development             # production: refuse weak JWT secrets and listen on all interfaces
# HOST=127.0.0.1                   # interface to listen on (default 127.0.0.1 outside production, all interfaces in production)
# RATE_LIMIT_MAX=300               # API requests per IP per 15 minutes
# UPLOAD_DAILY_LIMIT_MB=50         # image upload allowance per user per 24 hours
# ORPHAN_IMAGE_SWEEP_HOURS=6       # how often unused uploaded images are removed (0 turns it off)
# ORPHAN_IMAGE_MIN_AGE_HOURS=24    # uploads younger than this are never removed (minimum 1)
# REQUIRE_LISTING_APPROVAL=true   # true: buyers only see listings an admin has approved; false: auto-publish

# Admin account configuration (for seed script: node createAdmin.js)
# ADMIN_EMAIL=admin@ecocycle.com
# ADMIN_PASSWORD=ChangeThisPassword123!
# ADMIN_NAME=EcoCycle Administrator
# ADMIN_PHONE=9876543210

